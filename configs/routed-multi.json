  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "dns-china",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "detour": "proxy"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dns-china"
      }
    ],
    "final": "dns-remote",
    "strategy": "prefer_ipv4"
  },
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "port": [
          53
        ]
      },
      {
        "action": "route",
        "outbound": "direct",
        "domain_suffix": [
          "steamcontent.com"
        ],
        "ip_cidr": [
          "162.254.0.0/16",
          "153.254.86.0/24"
        ]
      },
      {
        "action": "route",
        "outbound": "proxy",
        "domain_regex": [
          "^stun\\..\u002B"
        ],
        "protocol": [
          "stun"
        ]
      },
      {
        "action": "reject",
        "domain_keyword": [
          "blocked"
        ],
        "port": [
          443
        ],
        "port_range": [
          "1000:2000"
        ]
      }
    ],
    "final": "proxy",
    "default_domain_resolver": "dns-china",
    "auto_detect_interface": true,
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-cn.srs",
        "initial_path": "rule-set\\geosite-cn.srs",
        "http_client": "rule-set-fetch",
        "update_interval": "1d"
      }
    ]
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9092"
    },
    "cache_file": {
      "enabled": true
    }
  }
}