<ui:FluentWindow x:Class="Netch.Views.ModeEditor.ProcessModeEditorView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:Netch.Controls"
    xmlns:loc="clr-namespace:Netch.Localization"
                 Title="{loc:I18N modeEditor.processTitle}"
                 Width="960" Height="800"
                 MinWidth="950" MinHeight="700"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource Brush.Background}">
    <!-- 进程模式编辑器（07§A1 三段式：参数区/进程列表/工具行）。纯绑定，保存即关窗 -->
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="saveButton" Style="{StaticResource Btn.Primary}" MinWidth="110"
                    Content="{loc:I18N modeEditor.saveClose}" Command="{Binding SaveCommand}" />
            <Button x:Name="cancelButton" MinWidth="88" Margin="8,0,0,0" Content="{loc:I18N common.cancel}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 参数区 -->
                <Border Background="{DynamicResource Brush.Card}" CornerRadius="{StaticResource Radius.Corner.M}"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:I18N modeEditor.remark}" VerticalAlignment="Center" Style="{StaticResource TextBlock.Caption}" />
                            <TextBox Grid.Column="1" Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <WrapPanel>
                            <controls:TriStateCheckBox Margin="0,0,20,10" Content="{loc:I18N modeEditor.handleTCP}" IsChecked="{Binding HandleTCP}" IsThreeState="True" ToolTip="{Binding GlobalHint}" />
                            <controls:TriStateCheckBox Margin="0,0,20,10" Content="{loc:I18N modeEditor.handleUDP}" IsChecked="{Binding HandleUDP}" IsThreeState="True" ToolTip="{Binding GlobalHint}" />
                            <controls:TriStateCheckBox Margin="0,0,20,10" Content="{loc:I18N modeEditor.handleICMP}" IsChecked="{Binding HandleICMP}" IsThreeState="True" ToolTip="{Binding GlobalHint}" />
                            <controls:TriStateCheckBox Margin="0,0,20,10" Content="{loc:I18N modeEditor.handleDNS}" IsChecked="{Binding HandleDNS}" IsThreeState="True" ToolTip="{Binding GlobalHint}" />
                            <controls:TriStateCheckBox Margin="0,0,20,10" Content="{loc:I18N modeEditor.handleProcDNS}" IsChecked="{Binding HandleProcDNS}" IsThreeState="True" ToolTip="{Binding GlobalHint}" />
                            <controls:TriStateCheckBox Margin="0,0,20,10" Content="{loc:I18N modeEditor.dnsProxy}" IsChecked="{Binding DNSProxy}" IsThreeState="True" ToolTip="{Binding GlobalHint}" />
                            <controls:TriStateCheckBox Margin="0,0,20,10" Content="{loc:I18N modeEditor.handleChild}" IsChecked="{Binding HandleChildProcess}" IsThreeState="True" ToolTip="{Binding GlobalHint}" />
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:I18N modeEditor.icmpDelay}" VerticalAlignment="Center" Style="{StaticResource TextBlock.Caption}" />
                            <TextBox Grid.Column="1" Width="110" Text="{Binding ICMPDelay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 进程列表区 -->
                <Border Background="{DynamicResource Brush.Card}" CornerRadius="{StaticResource Radius.Corner.M}"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="{loc:I18N modeEditor.processList}" Style="{StaticResource TextBlock.H2}" Margin="0,0,0,10" />
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="{loc:I18N common.add}" Margin="8,0,0,0" Command="{Binding AddProcessCommand}" />
                            <TextBox Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}"
                                     />
                        </DockPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox Grid.Row="0" x:Name="processList" MinHeight="200" MaxHeight="380"
                                     ItemsSource="{Binding Handle}" SelectedItem="{Binding SelectedProcess}"
                                     BorderBrush="{DynamicResource Brush.Stroke}" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{loc:I18N common.delete}" Style="{StaticResource Btn.Danger}" Command="{Binding RemoveProcessCommand}" Margin="0,0,8,0" />
                                <Button Content="{loc:I18N modeEditor.moveUp}" Command="{Binding MoveUpCommand}" Margin="0,0,8,0" />
                                <Button Content="{loc:I18N modeEditor.moveDown}" Command="{Binding MoveDownCommand}" Margin="0,0,8,0" />
                                <Button Content="{loc:I18N modeEditor.clear}" Style="{StaticResource Btn.Ghost}" Command="{Binding ClearProcessesCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <controls:RulesEditorControl Rules="{Binding Rules}" Editor="{Binding RulesEditor}" RulesError="{Binding RuleError}" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
