<ui:FluentWindow x:Class="Netch.Views.LocalRuleSetDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:Netch.Localization"
                 xmlns:local="clr-namespace:Netch.Views"
                 Title="{loc:I18N rulesets.local.title}" Width="960" Height="640"
                 MinWidth="800" MinHeight="540" WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource Brush.Background}">
    <ui:FluentWindow.Resources>
    </ui:FluentWindow.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="saveButton" Style="{StaticResource Btn.Primary}" MinWidth="100" Content="{loc:I18N common.save}" Click="Save_Click" />
            <Button x:Name="cancelButton" MinWidth="88" Margin="8,0,0,0" Content="{loc:I18N common.cancel}" Click="Cancel_Click" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:I18N rulesets.local.tag}" Style="{StaticResource TextBlock.Caption}" Margin="0,0,0,4" />
                <TextBox x:Name="tagBox" Text="{Binding RuleSetTag, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{loc:I18N rulesets.local.entries}" Style="{StaticResource TextBlock.H2}" DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="addEntryButton" Content="{loc:I18N rulesets.local.addEntry}" Click="AddEntry_Click" Margin="0,0,8,0" />
                        <Button x:Name="bulkImportButton" Content="{loc:I18N rulesets.local.bulkImport}" Click="BulkImport_Click" />
                    </StackPanel>
                </DockPanel>
                <Border x:Name="bulkPanel" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{loc:I18N rulesets.local.bulkHint}" TextWrapping="Wrap" Style="{StaticResource TextBlock.Caption}" Margin="0,0,0,6" />
                        <TextBox x:Name="bulkBox" AcceptsReturn="True" MinHeight="90" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="parseButton" Content="{loc:I18N rulesets.local.bulkImport}" Click="Parse_Click" Margin="0,0,8,0" />
                            <TextBlock x:Name="bulkResult" Style="{StaticResource TextBlock.Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="entriesGrid" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" CanUserAddRows="False"
                          MinHeight="190" MaxHeight="340" HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:I18N modeEditor.rule.dimension}" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Dimensions, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                              DisplayMemberPath="Text" SelectedValuePath="Kind" SelectedValue="{Binding Kind}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:I18N modeEditor.rule.value}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" LostFocus="Value_LostFocus" />
                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" Style="{StaticResource TextBlock.Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="↑" Tag="up" Click="MoveEntry_Click" Margin="0,0,4,0" />
                                        <Button Content="↓" Tag="down" Click="MoveEntry_Click" Margin="0,0,4,0" />
                                        <Button Content="×" Style="{StaticResource Btn.Ghost}" Click="DeleteEntry_Click" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="errorText" Foreground="{DynamicResource Brush.Danger}" Style="{StaticResource TextBlock.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>

