<ui:FluentWindow x:Class="Netch.Views.BypassIPDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:Netch.Localization"
                 Title="{loc:I18N settings.tun.bypassIps}"
                 Width="480" Height="380"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 Background="{DynamicResource Brush.Background}">
    <!-- 全局绕过 IP（07§D：多行文本，一行一 IP/CIDR + 校验 + 保存 TUNTAP.BypassIPs） -->
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextBlock.Caption}"
                   Text="{loc:I18N settings.tun.bypassHint}" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBlock x:Name="errorText" DockPanel.Dock="Bottom" Foreground="{DynamicResource Brush.Danger}"
                   Style="{StaticResource TextBlock.Caption}" Margin="0,8,0,0" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="saveButton" Style="{StaticResource Btn.Primary}" MinWidth="88" Content="{loc:I18N common.save}" />
            <Button x:Name="cancelButton" MinWidth="88" Margin="8,0,0,0" Content="{loc:I18N common.cancel}" />
        </StackPanel>
        <TextBox x:Name="ipBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" FontFamily="Consolas" />
    </DockPanel>
</ui:FluentWindow>
