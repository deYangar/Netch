<UserControl x:Class="Netch.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Netch.Localization"
             xmlns:controls="clr-namespace:Netch.Controls"
             Focusable="False">
    <!--
        主页（04§4）：服务器卡（搜索+过滤+行内操作）/ 模式卡 / Profile 卡片区。
        DataContext=HomeViewModel；新版本横幅文本/可见性经 Home.Main 转发（MainViewModel 状态栏区属性）。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" VerticalAlignment="Top">

            <!-- 页面标题（咩咩 2026-11-03：侧栏收起时点进任意页，右区要一眼知道这是哪） -->
            <TextBlock Text="{loc:I18N main.nav.home}" Style="{StaticResource TextBlock.H1}" Margin="0,0,0,12" />

            <!-- 新版本横幅 -->
            <Border Background="{DynamicResource Brush.Accent.Soft}"
                    CornerRadius="{StaticResource Radius.Corner.M}"
                    Padding="12,8"
                    Margin="0,0,0,12"
                    Visibility="{Binding Main.NewVersionVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Main.NewVersionText}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" />
                    <Button Content="↓" Margin="12,0,0,0" Padding="10,2"
                            ToolTip="{Binding Main.NewVersionText}"
                            Command="{Binding Main.NewVersionCommand}" />
                </StackPanel>
            </Border>

            <!-- 服务器卡（2026-10-28 收紧：局部 Padding 12 + 列表限高 160——默认窗口下此卡曾占内容区 ~75%，模式/Profile 卡被挤出首屏） -->
            <Border Background="{DynamicResource Brush.Card}"
                    CornerRadius="{StaticResource Radius.Corner.M}"
                    Padding="12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="{loc:I18N home.server.title}" Style="{StaticResource TextBlock.H2}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="8,0,0,0"
                                Command="{Binding TestAllDelayCommand}" Content="{loc:I18N home.server.testAll}" />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Width="140" Margin="8,0,0,0"
                                  ItemsSource="{Binding ServerTypes}"
                                  SelectedItem="{Binding ServerTypeFilter}" />
                    </StackPanel>

                    <ListBox x:Name="serverList" ItemsSource="{Binding FilteredServers}"
                             SelectedItem="{Binding SelectedServer}"
                             MinHeight="48" MaxHeight="160"
                             BorderBrush="{DynamicResource Brush.Stroke}"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             PreviewMouseLeftButtonDown="ServerList_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="ServerList_PreviewMouseLeftButtonUp"
                             MouseLeave="ServerList_MouseLeave"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <!-- 咩咩 2026-10-31 反馈②治本②：点击行获得焦点后，框架焦点滚动（ScrollIntoView）在
                             默认行单位模式（CanContentScroll）下是「顶对齐」——把选中行滚到视口顶，双击的
                             第二击落点错位到下一行（VM 实机复现）。像素滚动下对已可见项是最小滚动 no-op，
                             双击不再被带偏；视口外定位（ScrollIntoView）照常工作，虚拟化保留。
                             2026-10-31 踩坑：Focusable=false 方案报废——容器不可聚焦时鼠标点击选择整个失效
                             （harness 微测实锤：bubble MouseDown handled=True 但选中不变） -->
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <!-- 运行中锁选择（拦截在 code-behind），置灰防「点了该生效」误解（Profile 空槽同款 0.55）；
                                     行内测速/复制链接按钮命中不受 Opacity 影响，照常可用 -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanSelectServer}" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Remark}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border Background="{DynamicResource Brush.Accent.Soft}"
                                                CornerRadius="{StaticResource Radius.Corner.S}"
                                                Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{DynamicResource Brush.TextPrimary}" />
                                        </Border>
                                        <TextBlock Text="{Binding Endpoint}" Style="{StaticResource TextBlock.Caption}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- 行操作（hover 浮现，Min 高 32 命中目标） -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Content="{loc:I18N home.server.edit}" Style="{StaticResource Btn.Ghost}" Margin="0,0,4,0" MinHeight="32"
                                                Command="{Binding DataContext.EditServerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        <Button Content="{loc:I18N home.server.copyLink}" Style="{StaticResource Btn.Ghost}" Margin="0,0,4,0" MinHeight="32"
                                                Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        <Button Content="{loc:I18N home.server.test}" Style="{StaticResource Btn.Ghost}" Margin="0,0,4,0" MinHeight="32"
                                                Command="{Binding DataContext.TestOneDelayCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        <Button Content="{loc:I18N home.server.delete}" Style="{StaticResource Btn.Ghost}" Margin="0,0,4,0" MinHeight="32"
                                                Command="{Binding DataContext.DeleteServerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <controls:DelayBadge Grid.Column="2" Delay="{Binding Delay}" DelaySource="{Binding DelaySource}"
                                                         NotTestedText="{loc:I18N common.notTested}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空列表提示 -->
                    <TextBlock Text="{loc:I18N home.server.empty}" Margin="0,8,0,0" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredServers.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- ＋ 添加服务器（Popup 菜单：11 协议 + 从剪贴板导入） -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ToggleButton x:Name="addServerToggle" Content="{loc:I18N home.server.add}" MinHeight="32" Padding="12,4" />
                        <Popup IsOpen="{Binding IsChecked, ElementName=addServerToggle}"
                               StaysOpen="False"
                               PlacementTarget="{Binding ElementName=addServerToggle}"
                               Placement="Bottom"
                               AllowsTransparency="True">
                            <Border Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Stroke}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Corner.M}"
                                    Padding="4" Margin="12"
                                    MinWidth="200">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding AddableServerMenus}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <MenuItem Header="{Binding MenuText}"
                                                          Command="{Binding DataContext.AddServerCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                          CommandParameter="{Binding TypeName}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Separator />
                                    <MenuItem Header="{loc:I18N home.server.import}" Command="{Binding ImportFromClipboardCommand}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 模式卡 -->
            <Border Background="{DynamicResource Brush.Card}"
                    CornerRadius="{StaticResource Radius.Corner.M}"
                    Padding="{StaticResource Padding.Card}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:I18N home.mode.title}" Style="{StaticResource TextBlock.H2}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="260"
                                  ItemsSource="{Binding Modes}"
                                  SelectedItem="{Binding SelectedMode}"
                                  IsEnabled="{Binding CanSelectMode}" />
                        <Button Content="{loc:I18N home.mode.edit}" Margin="8,0,0,0" Command="{Binding EditModeCommand}" />
                        <!-- 新建模式：类型经 Popup 选择（进程模式 / TUN 路由模式），不必进设置改模式类型 -->
                        <ToggleButton x:Name="newModeToggle" Content="{loc:I18N home.mode.new}" Margin="4,0,0,0" MinHeight="32" Padding="12,4" />
                        <Popup IsOpen="{Binding IsChecked, ElementName=newModeToggle}"
                               StaysOpen="False"
                               PlacementTarget="{Binding ElementName=newModeToggle}"
                               Placement="Bottom"
                               AllowsTransparency="True">
                            <Border Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Stroke}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Corner.M}"
                                    Padding="4" Margin="12"
                                    MinWidth="160">
                                <StackPanel>
                                    <MenuItem Header="{loc:I18N home.mode.newProcess}"
                                              Click="NewModeMenu_Click"
                                              Command="{Binding NewProcessModeCommand}" />
                                    <MenuItem Header="{loc:I18N home.mode.newRoute}"
                                              Click="NewModeMenu_Click"
                                              Command="{Binding NewRouteModeCommand}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Button Content="{loc:I18N home.mode.delete}" Margin="8,0,0,0" Style="{StaticResource Btn.Danger}" Command="{Binding DeleteModeCommand}" />
                        <Button Content="{loc:I18N home.mode.reload}" Margin="4,0,0,0" Style="{StaticResource Btn.Ghost}" Command="{Binding ReloadModesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Profile 卡片区（点击=切换；右键=重命名/上移/下移/删除；激活槽描边） -->
            <Border Background="{DynamicResource Brush.Card}"
                    CornerRadius="{StaticResource Radius.Corner.M}"
                    Padding="{StaticResource Padding.Card}">
                <StackPanel>
                    <TextBlock Text="{loc:I18N main.profile.add}" Style="{StaticResource TextBlock.H2}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding ProfileSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8" CornerRadius="{StaticResource Radius.Corner.M}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasProfile}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Command="{Binding SelectCommand}"
                                            CommandParameter="{Binding}"
                                            MinWidth="96" MinHeight="36"
                                            Background="Transparent" BorderThickness="0">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </Button>
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{loc:I18N main.profile.rename}" Command="{Binding RenameCommand}" CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="{loc:I18N main.profile.moveUp}" Command="{Binding MoveUpCommand}" CommandParameter="{Binding}" />
                                            <MenuItem Header="{loc:I18N main.profile.moveDown}" Command="{Binding MoveDownCommand}" CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="{loc:I18N main.profile.delete}" Command="{Binding DeleteCommand}" CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
