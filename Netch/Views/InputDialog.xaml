<ui:FluentWindow x:Class="Netch.Views.InputDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Netch.Localization"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{loc:I18N main.profile.newTitle}"
                 Width="420" SizeToContent="Height"
                 MinWidth="420" MaxWidth="520" MaxHeight="320"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 Background="{DynamicResource Brush.Background}">
    <!-- Profile 重命名/新建小窗（04§1：或复用 ContentDialog；此处独立小窗支持标题区分） -->
    <StackPanel Margin="20">
        <TextBlock x:Name="promptText" Style="{StaticResource TextBlock.H2}" Margin="0,0,0,12" />
        <TextBox x:Name="inputBox" MinHeight="32" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="okButton" Style="{StaticResource Btn.Primary}" MinWidth="88" />
            <Button x:Name="cancelButton" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
