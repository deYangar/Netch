<UserControl x:Class="Netch.Controls.DataForm.DataForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:df="clr-namespace:Netch.Controls.DataForm"
             xmlns:loc="clr-namespace:Netch.Localization"
             Focusable="False">
    <!--
        DataForm（06§A2）：ItemsControl 两列布局（Label 右对齐 | 编辑器），行距 Spacing.S，整体左对齐（治本旧居中）。
        编辑器失焦/变更即跑 Validator → HasError/ErrorMessage 触发红描边 + Caption 错误文本。
    -->
    <UserControl.Resources>
        <df:FieldTypeTemplateSelector x:Key="FieldTemplateSelector" />

        <!-- 行模板：Label 右对齐(160) | 编辑器(*)，错误红描边 + Caption 错误文本（HasError 联动） -->
        <DataTemplate x:Key="FieldRow.Text" DataType="{x:Type df:FieldRowViewModel}">
            <StackPanel Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                               Style="{StaticResource TextBlock.Caption}" />
                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}"
                           Style="{StaticResource TextBlock.Caption}" Margin="182,2,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FieldRow.Password" DataType="{x:Type df:FieldRowViewModel}">
            <StackPanel Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                               Style="{StaticResource TextBlock.Caption}" />
                    <PasswordBox Grid.Column="1" df:PasswordBinder.BoundValue="{Binding Value, Mode=TwoWay}" />
                </Grid>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}"
                           Style="{StaticResource TextBlock.Caption}" Margin="182,2,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FieldRow.Select" DataType="{x:Type df:FieldRowViewModel}">
            <StackPanel Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                               Style="{StaticResource TextBlock.Caption}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" />
                </Grid>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}"
                           Style="{StaticResource TextBlock.Caption}" Margin="182,2,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FieldRow.Check" DataType="{x:Type df:FieldRowViewModel}">
            <StackPanel Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                               Style="{StaticResource TextBlock.Caption}" />
                    <CheckBox Grid.Column="1" Content="{Binding Label}" IsChecked="{Binding CheckValue}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FieldRow.Notice" DataType="{x:Type df:FieldRowViewModel}">
            <TextBlock Text="{Binding Label}" Style="{StaticResource TextBlock.Caption}" Margin="0,4,0,10" TextWrapping="Wrap" MaxWidth="460" />
        </DataTemplate>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=df:DataForm}}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource FieldTemplateSelector}" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
