<UserControl x:Class="Netch.Controls.RulesEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Netch.Localization"
             xmlns:controls="clr-namespace:Netch.Controls">
    <UserControl.Resources>
        <controls:RuleEditModeConverter x:Key="RuleMode" />
        <controls:InverseBooleanConverter x:Key="InverseBool" />
        <controls:BrushKeyConverter x:Key="BrushKey" />
        <controls:DisabledOpacityConverter x:Key="DisabledOpacity" />
    </UserControl.Resources>
    <Border x:Name="editorRoot" Background="{DynamicResource Brush.Card}" CornerRadius="{StaticResource Radius.Corner.M}" Padding="16">
        <StackPanel>
            <TextBlock Text="{loc:I18N modeEditor.rules.title}" Style="{StaticResource TextBlock.H2}" Margin="0,0,0,8" />
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="addRuleButton" Content="{loc:I18N modeEditor.addRule}" Command="{Binding AddRuleCommand}" Margin="0,0,8,6" />
                <Button Content="{loc:I18N common.delete}" Style="{StaticResource Btn.Danger}" Command="{Binding RemoveRuleCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,6" />
                <Button Content="{loc:I18N modeEditor.moveUp}" Command="{Binding MoveUpCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,6" />
                <Button Content="{loc:I18N modeEditor.moveDown}" Command="{Binding MoveDownCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,6" />
                <Button Content="{loc:I18N modeEditor.moveTop}" Command="{Binding MoveTopCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,6" />
                <Button Content="{loc:I18N modeEditor.moveBottom}" Command="{Binding MoveBottomCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,6" />
            </WrapPanel>
            <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False" CanUserAddRows="False"
                      MinHeight="160" MaxHeight="300" HeadersVisibility="Column" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:I18N modeEditor.rule.dimension}" Binding="{Binding SummaryText, Mode=OneWay}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="{loc:I18N modeEditor.col.ruleSet}" Binding="{Binding RuleSetText, Mode=OneWay}" Width="180" IsReadOnly="True" />
                    <DataGridTextColumn Header="{loc:I18N modeEditor.col.action}" Binding="{Binding ActionText, Mode=OneWay}" Width="90" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Background="{DynamicResource Brush.Surface}" CornerRadius="{StaticResource Radius.Corner.M}" Padding="12" Margin="0,12,0,0"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding SelectedEditable}">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:I18N modeEditor.col.action}" VerticalAlignment="Center" Style="{StaticResource TextBlock.Caption}" />
                        <ComboBox Grid.Column="1" Width="160" HorizontalAlignment="Left" ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{loc:I18N modeEditor.rule.editMode}" Style="{StaticResource TextBlock.Caption}" Width="120" VerticalAlignment="Center" />
                        <RadioButton x:Name="refModeRadio" Content="{loc:I18N modeEditor.rule.byRef}" IsChecked="{Binding EditMode, Converter={StaticResource RuleMode}, ConverterParameter=RuleSetRef}" Margin="0,0,16,0" />
                        <RadioButton x:Name="inlineModeRadio" Content="{loc:I18N modeEditor.rule.byInline}" IsChecked="{Binding EditMode, Converter={StaticResource RuleMode}, ConverterParameter=Inline}" />
                    </StackPanel>
                    <StackPanel x:Name="referencePanel" Visibility="{Binding EditMode, Converter={StaticResource RuleMode}, ConverterParameter=RuleSetRef}">
                        <TextBox x:Name="ruleSetSearch" TextChanged="Search_TextChanged" Margin="0,0,0,6">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <VisualBrush x:Key="RuleSetSearchHint" AlignmentX="Left" Stretch="None">
                                            <VisualBrush.Visual><TextBlock Text="{loc:I18N modeEditor.rule.search}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="4,3" /></VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Background" Value="{StaticResource RuleSetSearchHint}" /></Trigger></Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <ItemsControl ItemsSource="{Binding GroupedOptions}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource TextBlock.Caption}" Margin="0,8,0,2" /><ItemsPresenter /></StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsDisabled, Converter={StaticResource InverseBool}}" Opacity="{Binding IsDisabled, Converter={StaticResource DisabledOpacity}}" ToolTip="{Binding Hint}">
                                            <TextBlock Text="{Binding DisplayText}" Foreground="{Binding ForegroundToken, Converter={StaticResource BrushKey}}" />
                                        </CheckBox>
                                        <TextBlock Text="{Binding Hint}" Foreground="{Binding ForegroundToken, Converter={StaticResource BrushKey}}" Style="{StaticResource TextBlock.Caption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel x:Name="inlinePanel" Visibility="{Binding EditMode, Converter={StaticResource RuleMode}, ConverterParameter=Inline}">
                        <Button Content="{loc:I18N modeEditor.rule.addDimension}" HorizontalAlignment="Left" Click="AddDimension_Click" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Dimensions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox Width="190" ItemsSource="{Binding DataContext.DimensionChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      DisplayMemberPath="Text" SelectedValuePath="Kind" SelectedValue="{Binding Kind}" Margin="0,0,8,0" />
                                            <TextBox Width="400" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" LostFocus="Value_LostFocus" Margin="0,0,8,0" />
                                            <Button Content="×" Click="DeleteDimension_Click" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" Style="{StaticResource TextBlock.Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding RulesError, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Brush.Danger}" Style="{StaticResource TextBlock.Caption}" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>

