<!--
    深色调色板（语义 Token 具体色值，02§2 表）。key 与 Tokens.Light.xaml 同名，由 ThemeManager 整体替换。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Background" Color="#202020" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Brush.Card" Color="#323232" />
    <SolidColorBrush x:Key="Brush.Stroke" Color="#3F3F3F" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C8C8C8" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#7A7A7A" />

    <SolidColorBrush x:Key="Brush.Primary" Color="#4CC2FF" />
    <SolidColorBrush x:Key="Brush.Primary.Foreground" Color="#00243D" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#60CDFF" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#1F60CDFF" />

    <SolidColorBrush x:Key="Brush.Success" Color="#6CCB5F" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFD35C" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF99A4" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#4D6CCB5F" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#4DFFD35C" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#4DFF99A4" />

    <SolidColorBrush x:Key="Brush.Input.Background" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Brush.Input.Stroke" Color="#4A4A4A" />

    <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF" />

</ResourceDictionary>
